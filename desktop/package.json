{
  "name": "trawe-desktop",
  "version": "1.0.0",
  "description": "TraWe Desktop for Windows",
  "main": "main.cjs",
  "author": "TraWe",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . TraWe --platform=win32 --arch=x64 --out=release --overwrite --icon=build/icon.ico --app-version=1.0.0 --win32metadata.CompanyName=TraWe --win32metadata.FileDescription=TraWe --win32metadata.ProductName=TraWe",
    "installer:win": "npm run package:win && makensis installer.nsi"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "@electron/packager": "^18.3.6"
  }
}