{
  "version": 1,
  "sdk_version": "2.0.3",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ynhixtsjcbqehfraqvke.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "trawe",
      "version": "0.1.0",
      "title": "TraWe"
    },
    "tools": [
      {
        "name": "list_queries",
        "title": "List travel queries",
        "description": "List recent travel queries (leads) in the signed-in user's TraWe workspace, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "How many queries to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "search": {
              "description": "Optional name, email or destination to filter by.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_query",
        "title": "Get a travel query",
        "description": "Fetch one travel query (lead) with its itineraries and recent activities.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The query id."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_query",
        "title": "Create a travel query",
        "description": "Create a new travel query (lead) in the signed-in user's TraWe workspace.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 1,
              "description": "Traveller or contact name."
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "type": "string",
              "minLength": 3
            },
            "to_location": {
              "description": "Destination.",
              "type": "string",
              "minLength": 1
            },
            "from_location": {
              "type": "string",
              "minLength": 1
            },
            "travel_date": {
              "description": "Travel start date, YYYY-MM-DD.",
              "type": "string"
            },
            "nights": {
              "type": "integer",
              "minimum": 0,
              "maximum": 365
            },
            "adults": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "children": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "estimated_value": {
              "type": "number",
              "minimum": 0
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "full_name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_customers",
        "title": "List customers",
        "description": "List customers in the signed-in user's TraWe workspace, optionally filtered by name, email or phone.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "search": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_itineraries",
        "title": "List itineraries",
        "description": "List itineraries in the signed-in user's TraWe workspace, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "status": {
              "description": "Optional status filter, e.g. draft or confirmed.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "workspace_summary",
        "title": "Workspace summary",
        "description": "Counts of queries, customers, itineraries, bookings and invoices in the signed-in user's TraWe workspace.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
